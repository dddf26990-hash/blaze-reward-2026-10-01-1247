# ---- Base44 app ----
VITE_BASE44_APP_ID=your_base44_app_id

# ---- Site ----
SITE_URL=https://your-live-domain.com

# ---- Supabase (self-hosted / standalone deploy) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---- Discord OAuth (membership verification) ----
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://your-live-domain.com/auth/discord/callback

# ---- AI image generation ----
AI_IMAGE_API_KEY=your_image_generation_api_key

# ---- Admin ----
ADMIN_EMAIL=you@example.com
